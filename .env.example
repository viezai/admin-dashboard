# Cổng lắng nghe máy chủ
PORT=4000

# Mật khẩu / Mã khóa truy cập Admin Dashboard
ADMIN_KEY=viezai_admin_2026

# Tên miền Landing Page được phép gọi API (CORS)
# Nếu nhiều domain, ngăn cách bằng dấu phẩy, hoặc '*' để mở tất cả
CORS_ORIGIN=https://viezai.com,http://localhost:3000,http://localhost:8080

# Cấu hình Webhook gửi thông báo khi có liên hệ mới (Tùy chọn)
# Discord Webhook
DISCORD_WEBHOOK_URL=

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Generic Webhook
GENERIC_WEBHOOK_URL=